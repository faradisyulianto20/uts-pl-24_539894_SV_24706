# Environment configuration example untuk Docker Compose
# Salin berkas ini menjadi .env lalu isi nilainya sendiri.
# APP_KEY dibuat dengan: php artisan key:generate --show
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Database Credentials
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=uts_db
DB_USERNAME=uts_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Frontend Configuration
VITE_API_BASE=/api

# Google OAuth (Socialite) — isi dengan kredensial dari Google Cloud Console
# Authorized redirect URI di Google: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# URL frontend yang diakses browser (Docker Compose mempublish frontend di port 8080)
FRONTEND_URL=http://localhost:8080
