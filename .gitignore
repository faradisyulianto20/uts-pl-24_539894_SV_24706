# =========================================================
# 1. General OS / IDE artefacts
# =========================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# IDE / Editor
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------
# 2. Node / npm / Yarn artefacts (frontend)
# ---------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log
.pnpm-store/
.pnpm-workspace.yaml

# Vite / Vue temporary files
.vite/
dist/
build/
public/hot
public/mix-manifest.json

# ---------------------------------------------------------
# 3. Composer / PHP / Laravel artefacts (backend)
# ---------------------------------------------------------
/vendor/
composer.lock

# Laravel specific
/.env
/.env.*            # semua varian .env (misal .env.example, .env.testing)
/storage/*
/storage/*.key    # file kunci Laravel (APP_KEY) bila tidak di‑store di .env
/bootstrap/cache/
public/storage
/.phpunit.result.cache
/*.log
/coverage/
phpunit.xml
phpunit.xml.dist

# Laravel Mix / Vite generated files (jika pakai mix)
public/mix-manifest.json
public/hot

# ---------------------------------------------------------
# 4. Docker / Docker‑Compose artefact
# ---------------------------------------------------------
# Dockerfile cache layers (jika memakai build‑kit)
**/.dockerignore

# Docker Compose override / generated files
docker-compose.override.yml
docker-compose.*.yml     # bila ada file environment‑specific
# docker-compose.yml is committed (do NOT ignore)

# Named volumes (jika Anda mount ke folder lokal – biasanya tidak)
db_data/

# ---------------------------------------------------------
# 5. Test / CI artefacts
# ---------------------------------------------------------
/coverage/
*.coveralls.yml
*.codecov.yml
/.nyc_output/
jest.config.js
phpunit.xml
phpunit.xml.dist
/.github/workflows/*.log

# ---------------------------------------------------------
# 6. Miscellaneous
# ---------------------------------------------------------
/*.bak
/.tmp/
*.tmp
*.swp
*.swo
*.log
*.orig
*.seed
*.sql
*.sqlite
*.sqlite3

# End of .gitignore