      "id": 1,
      "title": "Berapa persentase CPU yang dikonsumsi masing-masing container saat ini?",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fg48nbm8yascgd"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total[1m])) by (id, name) * 100 > 0",
          "legendFormat": "{{name}} ({{id}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Berapa megabyte memori RAM yang digunakan oleh tiap container?",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fg48nbm8yascgd"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes) by (id, name) > 0",
          "legendFormat": "{{name}} ({{id}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Berapa laju permintaan HTTP per detik (RPS) yang masuk ke sistem?",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fg48nbm8yascgd"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(app_http_requests_total[1m])",
          "legendFormat": "Backend Laravel API (app_http_requests_total)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(promhttp_metric_handler_requests_total[1m]))",
          "legendFormat": "Prometheus Scrape Handler (promhttp_requests)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Apakah seluruh layanan dan container berada dalam kondisi hidup (UP)?",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "fg48nbm8yascgd"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} ({{instance}})",
          "refId": "A"
        }
      ]
    }
  ],
